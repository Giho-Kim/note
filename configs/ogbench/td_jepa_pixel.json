{
  "num_train_steps": 1000000,
  "data": {
    "name": "ogbench",
    "domain": "cube-single-play-v0",
    "obs_type": "pixels",
    "buffer_type": "parallel"
  },
  "env": {
    "name": "ogbench",
    "domain": "cube-single-play-v0",
    "task": "cube-single-play-singletask-task1-v0",
    "obs_type": "pixels",
    "frame_stack": 3
  },
  "agent": {
    "name": "TDJEPAFlowBCAgent",
    "compile": true,
    "model": {
      "device": "cuda",
      "obs_normalizer": {
        "name": "RGBNormalizerConfig"
      },
      "archi": {
        "phi_predictor": {
          "name": "ForwardArchi",
          "hidden_dim": 512,
          "hidden_layers": 2
        },
        "psi_predictor": {
          "name": "ForwardArchi",
          "hidden_dim": 512,
          "hidden_layers": 2
        },
        "actor": {
          "name": "noise_conditioned_actor",
          "hidden_dim": 512,
          "hidden_layers": 2
        },
        "actor_vf": {
          "hidden_layers": 4,
          "hidden_dim": 512
        },
        "phi_mlp_encoder": {
          "name": "BackwardArchi",
          "hidden_dim": 512,
          "hidden_layers": 0,
          "norm": true
        },
        "psi_mlp_encoder": {
          "name": "BackwardArchi",
          "hidden_dim": 512,
          "hidden_layers": 4,
          "norm": true
        },
        "rgb_encoder": {
          "name": "drq",
          "feature_dim": 256
        },
        "augmentator": {
          "name": "random_shifts",
          "pad": 2
        },
        "phi_dim": 256,
        "psi_dim": 50,
        "norm_z": true
      },
      "actor_use_full_encoder": false
    },
    "train": {
      "batch_size": 256,
      "discount": 0.99,
      "phi_ortho_coef": 1.0,
      "psi_ortho_coef": 1.0,
      "predictor_target_tau": 0.005,
      "encoder_target_tau": 0.005,
      "scale_train_goals": true
    }
  }
}
